include <iostream>
#include <string>
#include <cstdlib>
#include <ctime>
#include <algorithm>
using namespace std;

// Function 1: Convert Decimal to Binary (returns string)
string decimalToBinary(int decimal) {#
    if (decimal == 0) return "0";
    string binary = "";
    bool isNegative = false;
    if (decimal < 0) {
        isNegative = true;
        decimal = -decimal;
    }
    while (decimal > 0) {
        binary = char('0' + (decimal % 2)) + binary;
        decimal /= 2;
    }
    if (isNegative) binary = "-" + binary;
    return binary;
}

// Function 2: Convert Binary to Decimal (returns int)
int binaryToDecimal(string binary) {
    int decimal = 0;
    int base = 1;
    bool isNegative = false;
    if (!binary.empty() && binary[0] == '-') {
        isNegative = true;
        binary = binary.substr(1);
    }
    for (int i = binary.length() - 1; i >= 0; i--) {
        if (binary[i] == '1') {
            decimal += base;
        } else if (binary[i] != '0') {
            cout << "Invalid binary digit: " << binary[i] << endl;
            return 0;
        }
        base *= 2;
    }
    return isNegative ? -decimal : decimal;
}

// Function 3: Convert Decimal to Hexadecimal (returns string)
string decimalToHexadecimal(int decimal) {
    if (decimal == 0) return "0";
    string hex = "";
    bool isNegative = false;
    if (decimal < 0) {
        isNegative = true;
        decimal = -decimal;
    }
    char hexChars[] = "0123456789ABCDEF";
    while (decimal > 0) {
        hex = hexChars[decimal % 16] + hex;
        decimal /= 16;
    }
    if (isNegative) hex = "-" + hex;
    return hex;
}

// Function 4: Convert Hexadecimal to Decimal (returns int)
int hexadecimalToDecimal(string hex) {
    int decimal = 0;
    int base = 1;
    bool isNegative = false;
    if (!hex.empty() && hex[0] == '-') {
        isNegative = true;
        hex = hex.substr(1);
    }
    // Convert to uppercase for consistency
    transform(hex.begin(), hex.end(), hex.begin(), ::toupper);
    for (int i = hex.length() - 1; i >= 0; i--) {
        char c = hex[i];
        int value = 0;
        if (c >= '0' && c <= '9') value = c - '0';
        else if (c >= 'A' && c <= 'F') value = 10 + (c - 'A');
        else {
            cout << "Invalid hexadecimal digit: " << c << endl;
            return 0;
        }
        decimal += value * base;
        base *= 16;
    }
    return isNegative ? -decimal : decimal;
}

// Demo: Generate random integer 0-99 and convert to binary
void demo() {
    int randomNum = rand() % 100;
    cout << "Generated random integer: " << randomNum << endl;
    cout << "Binary representation: " << decimalToBinary(randomNum) << endl;
}

